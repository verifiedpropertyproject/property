# Postgres connection strings. Get both from your provider (Neon, Supabase, Vercel Postgres, etc).
# DATABASE_URL: the pooled connection, used for normal app queries.
# DIRECT_URL: the direct/unpooled connection, used only for running migrations.
# For pure local development without a hosted Postgres, point both at the same local Postgres
# instance (e.g. "postgresql://postgres:postgres@localhost:5432/property_marketplace").
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: real email sending for verification/password-reset links.
# Leave all five blank to use the MVP fallback (links shown directly on screen
# instead of emailed). See the README for provider examples (Gmail, Resend, Mailtrap).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Optional: file storage for property photos and supporting documents.
# Leave blank to use local disk (fine for local development). Set this when deploying anywhere
# without a persistent filesystem (Vercel, etc) — create a Blob store in your Vercel project
# dashboard and it sets this automatically; only set it by hand if managing it yourself.
BLOB_READ_WRITE_TOKEN=""
