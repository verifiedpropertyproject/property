generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for normal queries (required on serverless platforms like Vercel,
  // since each request may get a fresh connection — a direct Postgres connection per
  // invocation would exhaust the database's connection limit fast).
  url       = env("DATABASE_URL")
  // Unpooled/direct connection, used only for migrations. Most pooling proxies (PgBouncer,
  // Neon's pooler, Supabase's pooler) don't support the prepared statements Prisma Migrate
  // needs, so migrations must go straight to the database instead of through the pooler.
  directUrl = env("DIRECT_URL")
}

// role/type/status fields are plain strings rather than native Postgres enums, validated in
// application code. This was originally a SQLite constraint (no enum support there); kept as
// strings after the Postgres switch too, since the whole app already treats them this way and
// converting now would touch a lot of code for no functional benefit.
// role:         "ADMIN" | "BUYER" | "OWNER" | "AGENT"
//   OWNER lists their own property directly. AGENT lists on behalf of someone else
//   and must record who they're representing (see Property.representingName below).
// propertyType: "HOUSE" | "APARTMENT" | "LAND" | "COMMERCIAL" | "OTHER"
//   "OTHER" requires propertyTypeOther to be set (what it actually is).
// listingType:  "SALE" | "RENT"
// status:       "PENDING" | "APPROVED" | "REJECTED" | "CHANGES_REQUESTED"
//   This is the admin review workflow status — separate from availabilityStatus below.
// availabilityStatus: "AVAILABLE" | "RESERVED" | "SOLD" | "RENTED"
//   Set by the lister (Owner/Agent) or overridden by an admin. Changing this never affects
//   the review `status` above — a listing can be re-marked Available/Sold/etc. freely without
//   triggering re-review, unlike editing the listing's core details.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?
  password      String?
  role          String?
  image         String?
  emailVerified DateTime?
  suspended     Boolean   @default(false)
  // Account-level "Verified" badge for Owners/Agents (identity/legitimacy trust signal),
  // admin-controlled and distinct from Property.verified (which is per-listing). An admin can
  // still flip this directly at any time; the fields below are the request/review workflow that
  // normally leads to it.
  verified      Boolean   @default(false)
  // Seller/agent-initiated identity check: NOT_SUBMITTED (default/no request yet) | PENDING
  // (submitted, awaiting admin review) | APPROVED | REJECTED. Requested from the dashboard or
  // while creating a listing (see app/api/profile/identity-verification), reviewed by an admin
  // (see app/api/admin/users/[id]/identity-verification). Approving also sets `verified` above
  // to true; rejecting leaves it as-is (an admin can still hand-verify separately regardless of
  // this workflow). Shown on the seller's own listings so buyers can see it's in progress.
  identityVerificationStatus      String    @default("NOT_SUBMITTED")
  identityVerificationRequestedAt DateTime?
  identityVerificationReviewedAt  DateTime?
  // Admin's note on the decision — mainly used to explain a rejection so the seller knows what
  // to fix before resubmitting.
  identityVerificationNote        String?
  createdAt     DateTime  @default(now())

  properties              Property[]
  documents               PropertyDocument[]
  enquiries               Enquiry[]
  viewingRequests         ViewingRequest[]
  savedProperties         SavedProperty[]
  sentNotifications       Notification[]           @relation("sender")
  receivedNotifications   Notification[]           @relation("receiver")
  verificationTokens      EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  commissionAgreements    CommissionAgreement[]
}

// MVP note: there's no real email service wired up. A token is generated and
// its verification link is shown directly on screen (registration success page,
// and a "resend" action on the dashboard) as a stand-in for actually emailing it.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  expires   DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Same MVP fallback pattern as EmailVerificationToken: link is emailed if SMTP
// is configured, otherwise shown directly on screen.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  expires   DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id           String   @id @default(cuid())
  title        String
  description  String
  location     String
  // Structured pin location, set via the map picker on the listing form. All four are
  // optional/together — older listings (and any new listing where the lister skips the map)
  // simply have none of them set, and everything else keeps working as before.
  latitude     Float?
  longitude    Float?
  address      String?
  // Free-text place reference from the geocoder used to pick the pin (OpenStreetMap/Nominatim
  // place id in this app, kept as a generic string so swapping providers later doesn't need a
  // schema change).
  placeId      String?
  // Snapshotted 3% commission agreement, accepted once by the seller/agent when the listing is
  // created. commissionRate defaults to 3% but an admin can adjust it per-listing afterward —
  // agreedAt/agreementText stay as the original signed record even if the rate later changes.
  commissionRate         Float     @default(0.03)
  commissionAgreedAt     DateTime?
  commissionAgreementText String?
  propertyType String
  // Only set (and required) when propertyType is "OTHER" — what it actually is.
  propertyTypeOther String?
  listingType  String
  price        Float
  bedrooms     Int?
  bathrooms    Int?
  acreage      Float?
  // A path under /public (e.g. "/uploads/properties/<id>/<file>.jpg") produced by a real
  // upload — not a user-supplied external URL. See lib/propertyImageStorage.ts.
  imageUrl     String?
  // Optional walkthrough/tour video for the listing, stored the same way as imageUrl (public
  // Vercel Blob URL in production, /public path locally). See savePropertyVideo in
  // lib/propertyImageStorage.ts. Independent of the photo gallery below — a listing can have
  // photos, a video, both, or neither.
  videoUrl     String?
  status       String   @default("PENDING")
  adminNote    String?
  verified     Boolean  @default(false)
  // Due-diligence trust signals shown publicly on the listing's detail page, independent of the
  // review `status` above (a listing can be APPROVED/public while these are still Pending — they
  // represent Daktop's ongoing verification work, not a gate on going live). Admin-controlled
  // the same way `verified`/`featured` are, via app/api/properties/[id]/verification-status.
  locationVerified  Boolean @default(false)
  ownershipVerified Boolean @default(false)
  // Confirms the plot has been physically surveyed/beacons checked against the title, distinct
  // from ownership paperwork verification above.
  surveyVerified    Boolean @default(false)
  // "PENDING" | "SAFE_TO_BUY" | "NOT_SAFE" — Daktop's overall due-diligence verdict for this
  // listing. See lib/verificationStatus.ts for the authoritative list and display labels.
  daktopDecision    String  @default("PENDING")
  // Derived/cached: true once nothing above is left pending (see computeDaktopVerified in
  // lib/verificationStatus.ts). Recomputed server-side after any change to the fields it depends
  // on — never set directly by an admin — so listing cards can show the "DAKTOP VERIFIED" badge
  // without joining in documents on every read.
  daktopVerified    Boolean @default(false)
  featured     Boolean  @default(false)
  views        Int      @default(0)
  // Off by default — an admin must explicitly opt a listing in before the lister's contact
  // (phone) is shown to the public on that listing's page.
  showContact  Boolean  @default(false)
  availabilityStatus String @default("AVAILABLE")
  createdAt    DateTime @default(now())

  // Only set (and required) when listed by an AGENT — who they're selling on behalf of.
  representingName    String?
  representingContact String?

  sellerId String
  // Deleting a seller removes their listings too (which in turn cascades to
  // that listing's own enquiries/saves via the rules below).
  seller   User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  enquiries     Enquiry[]
  viewingRequests ViewingRequest[]
  savedBy       SavedProperty[]
  notifications Notification[]
  documents     PropertyDocument[]
  // Additional gallery photos beyond the required cover photo (imageUrl) — shown only on the
  // listing detail page. imageUrl alone is what's used anywhere a single thumbnail is needed
  // (homepage cards, admin/approval lists), so none of those views need to change.
  images        PropertyImage[]
  // Full signed history — Property.commissionRate/commissionAgreedAt/commissionAgreementText
  // above are a denormalized "latest at signing" cache for quick reads; this relation is the
  // actual audit trail (signed name, IP, user agent, generated certificate) and is never
  // overwritten. An admin changing Property.commissionRate later does NOT create a new row here
  // or touch the original signed record — see commission-rate/route.ts.
  commissionAgreements CommissionAgreement[]
}

// One row per commission-agreement signing (created once, at listing creation — never edited
// afterward). Property.commissionRate can drift from the rate captured here if an admin later
// adjusts it; that's intentional and surfaced explicitly wherever this is displayed.
model CommissionAgreement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rate             Float
  agreementVersion Int
  agreementText    String
  // Typed full legal name, entered as the signature at listing creation.
  signedName String
  ipAddress  String?
  userAgent  String?
  signedAt   DateTime @default(now())

  // Vercel Blob URL of the generated PDF certificate. Deliberately never sent to the client —
  // it's fetched server-side and streamed through an authenticated route (see
  // app/api/properties/[id]/commission-agreement/route.ts) so the certificate (which contains
  // the signer's name and IP) isn't reachable via a leaked/guessed direct link.
  certificateUrl String?

  createdAt DateTime @default(now())
}

// documentType: "TITLE_DEED" | "OFFICIAL_SEARCH" | "OWNERSHIP_DOCUMENT" | "SALE_AGREEMENT" |
//               "AUTHORIZATION_LETTER" | "AGENCY_MANAGEMENT_AGREEMENT" |
//               "AGENCY_COMPANY_DOCUMENT" | "AGENT_LICENSE" | "OTHER" |
//               null (unspecified — the type is optional)
// See lib/documentTypes.ts for the authoritative list and display labels.
//
// Files are stored on disk under a private `uploads/` directory (NOT under `public/`, so they
// can't be fetched by guessing a URL) and are only ever served through an authenticated route
// that checks the requester is the property's own lister or an admin — these are sensitive
// ownership documents, not public listing photos.
model PropertyDocument {
  id           String   @id @default(cuid())
  documentType String?
  fileName     String // original filename, shown to users
  storedName   String // randomized filename actually used on disk, to avoid collisions
  mimeType     String?
  fileSize     Int
  // Admin confirms they've actually reviewed/received this document — separate from it merely
  // having been uploaded by the lister. Drives the tick/pending shown next to its name on the
  // public listing page. Toggled via app/api/documents/[id]/verify, same pattern as
  // Property.verified.
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

// Extra gallery photos for a listing, beyond the required cover photo stored on
// Property.imageUrl. Ordered by createdAt (oldest first) — no explicit sort field needed since
// sellers add them one batch at a time and there's no reordering UI.
model PropertyImage {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// status: "PENDING" | "APPROVED" | "REJECTED" — an admin must approve an enquiry
// before the seller can see it.
model Enquiry {
  id        String   @id @default(cuid())
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User @relation(fields: [buyerId], references: [id], onDelete: Cascade)
}

// A buyer's request to physically view a property in person. Same admin-moderated shape as
// Enquiry above (an admin must approve before the seller sees it, to filter spam/abuse before
// it turns into a real-world visit) — status: "PENDING" | "APPROVED" | "REJECTED".
// preferredDate is the buyer's requested viewing date/time; the actual visit is then arranged
// directly between buyer and seller (phone/notification), so there's no further in-app
// scheduling state beyond this request's own approval status.
model ViewingRequest {
  id            String   @id @default(cuid())
  preferredDate DateTime
  message       String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User @relation(fields: [buyerId], references: [id], onDelete: Cascade)
}

model SavedProperty {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  buyerId String
  buyer   User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([buyerId, propertyId])
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  senderId   String
  receiverId String
  propertyId String?

  // Deleting either party in a notification removes it too — there's no "deleted user"
  // placeholder concept in this MVP, so keeping an orphaned notification around isn't useful.
  sender   User      @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}
